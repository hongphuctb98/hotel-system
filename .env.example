# ──────────────────────────────────────────────────────────────────────────────
# Database — matches docker-compose.yml credentials
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://hotel:hotel_secret@localhost:5432/hotel_db"

# ──────────────────────────────────────────────────────────────────────────────
# JWT — generate two random 32+ char strings (e.g. openssl rand -base64 32)
# ──────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret"

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────────────────────
# Storage — file uploads (images, documents)
# ──────────────────────────────────────────────────────────────────────────────
# "local"  → write to public/uploads/ (local dev only, not supported on Vercel)
# "s3"     → upload to S3-compatible bucket (required on serverless platforms)
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER=s3
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# Optional: S3-compatible endpoint — leave empty for AWS S3
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO local:   http://localhost:9000
S3_ENDPOINT=""

# Optional: custom public URL for files (CloudFront, R2 custom domain, etc.)
# If empty, files are served from the default bucket URL
S3_PUBLIC_URL=""
