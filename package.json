    "@prisma/client": "^7.6.0",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.96.0",
    "antd": "^6.3.5",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.20",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.2",
    "next-intl": "^4.8.4",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
